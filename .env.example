# Obsidian Vault の絶対パス。引用符を付けないこと（SPEC §3.4）
#   正しい: OBSIDIAN_VAULT=/Users/USERNAME/Documents/Obsidian Vault
#   誤り  : OBSIDIAN_VAULT="/Users/USERNAME/Documents/Obsidian Vault"
#           （Compose が値をそのまま解釈するため、引用符が文字列の一部になる）
OBSIDIAN_VAULT=/Users/USERNAME/Documents/Obsidian Vault

# Helper とコンテナが共有する作業領域（SPEC §4.1）。
# /Users 配下であること（VirtioFS が正常に扱えるのはローカルディスク上のパスのみ。§5.6, V-28）
VOICEDOCK_HOME=/Users/USERNAME/VoiceDock

# タイムゾーン
TZ=Asia/Tokyo
